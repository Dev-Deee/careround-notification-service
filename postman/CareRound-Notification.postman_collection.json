{
  "info": {
    "_postman_id": "3752cd2a-5b13-454e-b64e-eafcf4665ec4",
    "name": "CareRound - Notification Service",
    "description": "Drives every event notification-service consumes, through the producing services' real APIs:\nuser.registered + user.verification_resent (auth), PATIENT_EMERGENCY_DECLARED and PATIENT_REVIEW_COMPLETED (round).\nnotification-service has no REST API of its own: results are checked in its console and in careround_notification_db.\nSet superAdminPassword in the environment first. Tokens refresh automatically (collection pre-request script).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level: (1) auto-login, (2) fail fast on unset ids.",
          "// (1) Access tokens last 15 min. Any role whose email + password are in the environment gets a fresh",
          "//     token when its current one is missing or expires within 60 s, so long runs never hit 401s.",
          "const roles = [['superAdmin', 'superAdminEmail', 'superAdminPassword'],",
          "               ['doctor', 'doctorEmail', 'doctorPassword'],",
          "               ['nurse', 'nurseEmail', 'nursePassword']];",
          "function expiresSoon(token) {",
          "    if (!token) return true;",
          "    try {",
          "        const b64 = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
          "        return JSON.parse(require('atob')(b64)).exp * 1000 - Date.now() < 60000;",
          "    } catch (e) { return true; }",
          "}",
          "const isLoginRequest = pm.request.url.getPath().endsWith('/api/v1/auth/login');",
          "roles.forEach(([role, emailVar, passwordVar]) => {",
          "    if (isLoginRequest) return;                              // the request itself logs in",
          "    const email = pm.environment.get(emailVar), password = pm.environment.get(passwordVar);",
          "    if (!email || !password || !expiresSoon(pm.environment.get(role + 'AccessToken'))) return;",
          "    pm.sendRequest({",
          "        url: pm.environment.get('authBaseUrl') + '/api/v1/auth/login', method: 'POST',",
          "        header: { 'Content-Type': 'application/json' },",
          "        body: { mode: 'raw', raw: JSON.stringify({ identifier: email, password: password }) }",
          "    }, (err, res) => {",
          "        if (!err && res.code === 200) pm.environment.set(role + 'AccessToken', res.json().accessToken);",
          "        else console.warn('Auto-login failed for ' + role + ': ' + (err || res.code));",
          "    });",
          "});",
          "// (2) Stale or missing ids used to be sent as UUID \"null\". Stop with a clear message instead.",
          "const text = pm.request.url.toString() + ((pm.request.body && pm.request.body.raw) || '');",
          "(text.match(/{{\\s*[A-Za-z]\\w*\\s*}}/g) || []).forEach(ref => {",
          "    const name = ref.replace(/[{}\\s]/g, '');",
          "    if (name.endsWith('AccessToken')) return;              // filled by the auto-login above",
          "    if (/[Kk]ey$/.test(name)) return;                      // idempotency keys: generated by the request's own pre-request script",
          "    const value = pm.variables.get(name);",
          "    if (value === undefined || value === '' || value === 'null') {",
          "        throw new Error('{{' + name + '}} is not set. Run the request that captures it first (or set it in the environment).');",
          "    }",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 - Bootstrap",
      "item": [
        {
          "name": "Login - Super Admin (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{authBaseUrl}}/api/v1/auth/login",
              "host": [
                "{{authBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{superAdminEmail}}\",\n  \"password\": \"{{superAdminPassword}}\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Capture super admin token + a fresh runId for unique emails', function () {",
                  "    pm.environment.set('superAdminAccessToken', pm.response.json().accessToken);",
                  "    pm.environment.set('runId', String(Date.now()).slice(-8));",
                  "    // new run = new users: forget the previous run's staff",
                  "    ['doctorEmail', 'doctorPassword', 'doctorAccessToken', 'nurseEmail', 'nursePassword', 'nurseAccessToken']",
                  "        .forEach(v => pm.environment.unset(v));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
